# PostgreSQL connection used by Prisma
# For the included Docker Compose service:
DATABASE_URL="postgresql://techdesk:techdesk_dev_password@localhost:5432/techdesk?schema=public"

# Comma-separated browser origins allowed to call the API.
# Keep production values restricted to the real frontend origin(s).
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Public registration is disabled by default for production.
# Enable it only during controlled initial account provisioning, then disable it again.
AUTH_ALLOW_REGISTRATION="false"

# Optional frontend API URL
# VITE_API_URL="http://localhost:3001/api"
