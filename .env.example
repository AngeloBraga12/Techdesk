# PostgreSQL connection used by Prisma
# For the included Docker Compose service:
DATABASE_URL="postgresql://techdesk:techdesk_dev_password@localhost:5432/techdesk?schema=public"

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Set to true only during controlled initial account provisioning.
# In production, disable public registration after creating the first administrator.
AUTH_ALLOW_REGISTRATION="true"

# Optional frontend API URL
# VITE_API_URL="http://localhost:3001/api"
