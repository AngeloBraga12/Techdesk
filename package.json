{
  "name": "techdesk",
  "private": true,
  "version": "1.3.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && vite build",
    "lint": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "dev:all": "concurrently \"vite\" \"tsx watch server/index.ts\"",
    "server": "tsx server/index.ts",
    "server:dev": "tsx watch server/index.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:migrate": "prisma migrate dev",
    "preview": "vite preview"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "concurrently": "^9.1.0",
    "prisma": "^7.10.0",
    "tsx": "^4.19.2"
  },
  "overrides": {
    "hono": "^4.13.7",
    "valibot": "^1.2.0",
    "@hono/node-server": "^1.19.17"
  }
}
